{
  "manifest_version": 3,
  "name": "TubeFolders",
  "version": "1.0.0",
  "description": "Group YouTube subscriptions into folders with Lucide icons. Sync with Google + Firestore.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TubeFolders",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://accounts.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://*.cloudfunctions.net/*",
    "https://*.firebaseapp.com/*"
  ],
  "oauth2": {
    "client_id": "1033436935931-3eghs4vuo8krmktffi9band8trj15tso.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/inject.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "key": ""
}
